# Required for a public deployment. Use a long random value.
ADMIN_KEY=replace-with-a-long-random-admin-key

# Public URL of the backend API. Used when NFT image URLs are generated.
APP_URL=https://api.example.com

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=https://www.example.com

# Optional absolute path when the hosting provider does not persist the app directory.
# HYPEBLOCK_DATA_FILE=/home/account/private/hypeblock/store.json