modules = ["nodejs-20", "python-3.12", "web", "bash"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "HYPEBLOCK Preview"

[[workflows.workflow]]
name = "HYPEBLOCK Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c './.pythonlibs/bin/uvicorn backend.server:app --host 0.0.0.0 --port 8000 & cd frontend && PORT=5000 BROWSER=none yarn start'"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 80
